# Copy to .env and fill in. .env itself is git-ignored and must stay that way.

# Supabase project URL.
# Supabase dashboard: Project Settings -> API -> Project URL.
VITE_SUPABASE_URL=

# Supabase anon/publishable API key. Safe to ship to the browser — it is RLS,
# not this key, that protects the data.
# Supabase dashboard: Project Settings -> API -> Project API keys -> anon public.
VITE_SUPABASE_ANON_KEY=

# Accounts the integration tests sign in as. They are created automatically on
# the first run. Any valid-format address works while email confirmation is off.
# No VITE_ prefix: that prefix is what exposes a variable to the browser bundle.
TEST_USER_A_EMAIL=
TEST_USER_B_EMAIL=
TEST_USER_PASSWORD=
