# Copy to .env and fill in. .env itself is git-ignored and must stay that way.

# Supabase project URL.
# Supabase dashboard: Project Settings -> API -> Project URL.
VITE_SUPABASE_URL=

# Supabase anon/publishable API key. Safe to ship to the browser — it is RLS,
# not this key, that protects the data.
# Supabase dashboard: Project Settings -> API -> Project API keys -> anon public.
VITE_SUPABASE_ANON_KEY=

# Accounts the integration tests sign in as. They are created automatically on
# the first run. Any valid-format address works while email confirmation is off.
# No VITE_ prefix: that prefix is what exposes a variable to the browser bundle.
TEST_USER_A_EMAIL=
TEST_USER_B_EMAIL=
TEST_USER_PASSWORD=

# The Manager and Admin accounts the Part 4 role tests sign in as. Created
# automatically on the first run like the customer accounts above, but their
# ROLES must then be granted by running supabase/seed_staff.sql with these
# same two addresses. Leave blank to skip the role-specific tests.
TEST_MANAGER_EMAIL=
TEST_ADMIN_EMAIL=

# The chef account the Part 5 kitchen tests sign in as. Created automatically on
# the first run like the accounts above, but its ROLE must then be granted by
# running supabase/chef.sql with this same address. Leave blank to skip the
# kitchen tests - the Manager and Admin tests still run.
TEST_CHEF_EMAIL=
